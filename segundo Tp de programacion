#4. RECURSIÓN SOBRE EL DOMINIO + TRAZA

def generar_informe_recursivo(equipo: list, indice: int = 0, nivel_llamada: int = 1) -> list:
    """
    Recorre el dataset `equipo` mediante recursión sobre el dominio.
    - Caso base: cuando `indice` alcanza el largo de la lista.
    - Paso recursivo: procesa el Pokémon en `indice` y llama a `indice + 1`.
    """
    indent = "  " * (nivel_llamada - 1)
    print(f"{indent}[TRAZA -> Llamada #{nivel_llamada}] indice={indice}, pendientes={len(equipo) - indice}")

    # CASO BASE: ya no quedan Pokémon por revisar
    if indice == len(equipo):
        print(f"{indent}[TRAZA -> CASO BASE] indice == {len(equipo)}. Fin de la recursión.\n")
        return []

    actual = equipo[indice]
    stats = actual["stats"]

    linea_informe = (
        f"• {actual['especie']} (Nv. {actual['nivel']} | {actual['sexo']} | {actual['ps']} PS)\n"
        f"  Captura: {actual['atrapado_en']} (Estación: {actual['estacion']})\n"
        f"  Fuerza: {stats['fuerza']} | Velocidad: {stats['velocidad']} | Defensa: {stats['defensa']} | "
        f"At. Esp.: {stats['ataque_especial']} | Def. Esp.: {stats['defensa_especial']} | Suerte: {stats['suerte']}"


    print(f"{indent}[TRAZA -> Procesando] {actual['especie']} en posición {indice}")

    # PASO RECURSIVO
    resto_informe = generar_informe_recursivo(equipo, indice + 1, nivel_llamada + 1)

    print(f"{indent}[TRAZA -> Retorno #{nivel_llamada}] Finalizado {actual['especie']}")
    return [linea_informe] + resto_informe
    
