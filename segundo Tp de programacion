class Nodo:

   def __init__(self, dato):

    self.dato = dato

    self.siguiente = None

from src.tads.nodo import Nodo





class IteradorListaEnlazada:



  def __init__(self, cabeza):

    self.actual = cabeza



  def __iter__(self):

    return self



  def __next__(self):

    if self.actual is None:

      raise StopIteration

    dato = self.actual.dato

    self.actual = self.actual.siguiente

    return dato





class ListaEnlazada:



  def __init__(self):

    self.cabeza = None

    self._tamanio = 0



  def esta_vacia(self):

    return self.cabeza is None



  def agregar(self, dato):

    nuevo_nodo = Nodo(dato)

    if self.esta_vacia():

      self.cabeza = nuevo_nodo

    else:

      actual = self.cabeza

      while actual.siguiente:

        actual = actual.siguiente

      actual.siguiente = nuevo_nodo

    self._tamanio += 1



  def __len__(self):

    return self._tamanio



  def __iter__(self):

    return IteradorListaEnlazada(self.cabeza)



class Pokemon:

  def __init__(self, numero, nombre, tipo, evolucion, descripcion):

    self.numero = numero

    self.nombre = nombre

    self.tipo = tipo

    self.evolucion = evolucion

    self.descripcion = descripcion



  def __str__(self):

    return (f"#{self.numero} - {self.nombre} ({self.tipo}) | Línea Evolutiva:"f" {self.evolucion})



import csv

from src.dominio.pokemon import Pokemon

from src.tads.lista_enlazada import ListaEnlazada



def cargar_pokedex_desde_csv(ruta_archivo):

  lista_pokedex = ListaEnlazada()

  try:

    with open(ruta_archivo, mode="r", encoding="utf-8") as archivo:

      lector = csv.DictReader(archivo)

      for fila in lector:

        pokemon = Pokemon(

            numero=fila["numero"],

            nombre=fila["nombre"],

            tipo=fila["tipo"],

            evolucion=fila["evolucion"],

            descripcion=fila["descripcion"],

        )

        lista_pokedex.agregar(pokemon)

  except FileNotFoundError:

    print: (f"[!] Advertencia: No se encontró el archivo '{ruta_archivo}' en la"

        " ruta especificada.")

  return lista_pokedex



